# Reference only. Initialize-Local.ps1 creates .env with random local secrets.
# Existing .env and user-secret values are preserved by the helper.
API_PORT=8080
SQL_PORT=14333
APP_DB_NAME=OrderInventory
JWT_ISSUER=OrderInventory.Local
JWT_AUDIENCE=OrderInventory.Client
JWT_ACCESS_TOKEN_MINUTES=30
SQL_SA_PASSWORD=<generated-locally>
JWT_SIGNING_KEY_BASE64=<generated-locally>
BOOTSTRAP_ADMIN_LOGIN=<approved-admin-login>
BOOTSTRAP_ADMIN_PASSWORD=<generated-locally>
BOOTSTRAP_STAFF_LOGIN=<approved-staff-login>
BOOTSTRAP_STAFF_PASSWORD=<generated-locally>

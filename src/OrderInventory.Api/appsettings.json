{
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OrderInventory.Local",
    "Audience": "OrderInventory.Client",
    "AccessTokenMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  }
}
